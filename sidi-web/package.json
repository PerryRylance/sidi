{
  "name": "@perry-rylance/sidi",
  "author": "Perry Rylance",
  "license": "MIT",
  "description": "A MIDI interface for a web emulation of the famous SID chip",
  "version": "0.0.0",
  "keywords": [
    "midi",
    "sid",
    "c64",
    "synth"
  ],
  "homepage": "https://perryrylance.dev",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./helper": {
      "types": "./dist/helper.d.mts",
      "default": "./dist/helper.mjs"
    },
    "./worklet": {
      "types": "./dist/SidiAudioWorkletProcessor.d.ts",
      "default": "./dist/SidiAudioWorkletProcessor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.gitkeep",
    "bin"
  ],
  "bin": {
    "sidi-publish": "./bin/sidi-publish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryRylance/sidi.git",
    "directory": "sidi-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "npx tsx scripts/build-wasm.ts",
    "build:worklet": "npx tsx scripts/build-worklet.ts",
    "midi:render": "npx tsx scripts/generate-wav.ts",
    "midi:listen": "npx tsx scripts/listen.ts",
    "midi:explain": "npx tsx scripts/explain.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "vite",
    "test:dist": "npm run build:worklet && attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm && docker compose run --rm browser-tests",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:dist"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@perry-rylance/midi": "^1.1.5",
    "@perry-rylance/midi-macros": "^0.0.3",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^25.9.3",
    "@types/wav": "^1.0.4",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "case": "^1.6.3",
    "console-table-printer": "^2.16.1",
    "playwright": "1.65.1",
    "rolldown-plugin-dts": "^0.27.14",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wav": "^1.0.2"
  },
  "engines": {
    "node": ">=20.16"
  },
  "peerDependencies": {
    "@perry-rylance/midi": "^1.1.5"
  },
  "peerDependenciesMeta": {
    "@perry-rylance/midi": {
      "optional": true
    }
  }
}
