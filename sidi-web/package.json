{
  "name": "@perry-rylance/sidi",
  "author": "Perry Rylance",
  "license": "MIT",
  "description": "A MIDI interface for a web emulation of the famous SID chip",
  "version": "0.0.0",
  "scripts": {
    "build:wasm": "npx tsx scripts/build-wasm.ts",
    "build:worklet": "npx tsx scripts/build-worklet.ts",
    "midi:render": "npx tsx scripts/generate-wav.ts",
    "midi:listen": "npx tsx scripts/listen.ts",
    "midi:explain": "npx tsx scripts/explain.ts",
    "test": "vitest run",
    "demo": "vite",
    "test:dist": "npm run build:worklet && docker compose run --rm browser-tests",
    "prepublishOnly": "npm test && npm run test:dist"
  },
  "dependencies": {
    "@perry-rylance/midi": "^1.1.5"
  },
  "devDependencies": {
    "@perry-rylance/midi-macros": "^0.0.3",
    "@types/audioworklet": "^0.0.100",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/wav": "^1.0.4",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "case": "^1.6.3",
    "console-table-printer": "^2.16.1",
    "happy-dom": "^20.10.3",
    "jest": "^30.4.2",
    "playwright": "1.65.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wav": "^1.0.2"
  },
  "engines": {
    "node": ">=20.16"
  }
}
